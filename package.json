{
  "name": "smelt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "email:shipping": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/send-shipping.ts",
    "admin:setup": "tsx scripts/setup-admin.ts",
    "reviews:rank": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/rank-reviews.ts",
    "reviews:google": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/export-google-reviews.ts",
    "admin:import-shipping": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-shipping-receipts.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migration/postgres-migrate.ts",
    "db:test": "vitest run lib/db",
    "migration:reviews": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migration/import-review-custom.ts",
    "migration:orders": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migration/import-orders.ts",
    "migration:capture-orders": "tsx --env-file-if-exists=.env.local scripts/migration/capture-orders.ts",
    "migration:preflight-orders": "tsx --env-file-if-exists=.env.local scripts/migration/preflight-orders.ts",
    "migration:capture": "tsx --env-file-if-exists=.env.local scripts/migration/capture.ts",
    "migration:audit": "tsx scripts/migration/audit.ts",
    "migration:restore-test": "tsx scripts/migration/restore-test.ts",
    "migration:finalize": "tsx scripts/migration/finalize.ts",
    "migration:triage": "tsx scripts/migration/triage.ts",
    "migration:benchmark": "tsx --env-file-if-exists=.env.local scripts/migration/benchmark.ts",
    "migration:package": "tsx scripts/migration/package.ts",
    "migration:reconcile-provider": "tsx --env-file-if-exists=.env.local scripts/migration/reconcile-provider.ts"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.26.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/browser": "^0.1.5",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "^16.3.5",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^20",
    "@types/paystack__inline-js": "^1.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
