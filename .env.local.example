# Paystack — copy this file to .env.local and fill in your secret key.
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use the TEST secret key (sk_test_...) while developing, LIVE (sk_live_...) in production.
# This is a SECRET key: it must never be committed or exposed to the browser.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Google Maps Places API (Address Autocomplete at checkout).
# Enable Places API in Google Cloud Console. Optional; falls back to manual input if blank.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend (required for automatic customer order confirmations).
RESEND_API_KEY=
# Sender address. Required for order confirmations; use your verified Resend domain.
# Example (verify this sender in your Resend account):
#   ORDER_FROM_EMAIL=Smelt <orders@saunahat.co.za>
ORDER_FROM_EMAIL=

# Absolute site URL used for links and images inside emails (no trailing slash).
# Example: https://saunahat.co.za
SITE_URL=https://saunahat.co.za

# Personal checkout follow-up alerts (Upstash Redis + Vercel Pro cron).
# Disabled until explicitly enabled. Use separate databases for test and production.
CHECKOUT_FOLLOWUP_ENABLED=false
# Also required for order-confirmation deduplication, independently of the follow-up flag.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Your own inbox, never a customer address. This setting controls the separate owner alert only.
CHECKOUT_FOLLOWUP_TO=
# Customer abandoned-cart sequence. Only newly captured, explicitly opted-in
# checkout leads are eligible. Sends at about 1h, 24h and 72h with a R50 code.
CART_EMAIL_SEQUENCE_ENABLED=false
# Generate a long random secret. Vercel includes it in cron Authorization headers.
CRON_SECRET=

# Customer review requests. When enabled, completed orders become eligible
# after 10 days. The daily cron sends at most 10 and skips existing reviews or
# manually-created review links. Review reward emails do not depend on this flag.
REVIEW_REQUESTS_ENABLED=false

# Vercel Blob (optional review photos).
# New Vercel project connections set BLOB_STORE_ID and provide short-lived OIDC
# credentials automatically at runtime. BLOB_WEBHOOK_PUBLIC_KEY is also managed
# by Vercel and is not a replacement for a read-write token.
BLOB_STORE_ID=
# Legacy/local fallback only. New OIDC-connected deployments do not need this.
BLOB_READ_WRITE_TOKEN=

# Private admin dashboard (server-side only; use a unique generated password)
# Generate locally with: npm run admin:setup
# ADMIN_PASSWORD must contain at least 5 characters; use a unique generated password in production.
# Set the same value in Vercel Production before deploying /admin.
